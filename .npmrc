# Paksa devDependencies ikut terpasang walau NODE_ENV=production.
#
# Tanpa baris ini, npm 11 melewatkan devDependencies (vitest, vite, svelte,
# svelte-check, wrangler, sharp) saat NODE_ENV=production — dan `npm install`
# malah memangkas paket yang sudah ada sampai node_modules nyaris kosong.
include=dev
