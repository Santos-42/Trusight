{
  "name": "trusight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply trusight-db --local",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^4.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.48.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "exifr": "^7.1.3",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-svelte": "^0.469.0",
    "pdf-lib": "^1.17.1",
    "signature_pad": "^5.1.4",
    "zod": "^3.23.0"
  }
}
